+// Desktop adapter: credentials remain in process memory; never persist them.
+function buildDesktopClientConfig(ctx, directory, env = process.env) {
+  const baseUrl = ctx.serverUrl?.toString();
+  if (!baseUrl) throw new Error('OpenCode did not provide its backend URL');
+  const url = new URL(baseUrl);
+  if (!['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname))
+    throw new Error('This adapter only supports a local desktop backend');
+  const password = env.OPENCODE_SERVER_PASSWORD;
+  const username = env.OPENCODE_SERVER_USERNAME ?? 'opencode';
+  return {
+    baseUrl,
+    directory: directory || undefined,
+    ...(password ? { headers: { Authorization: 'Basic ' + Buffer.from(username + ':' + password).toString('base64') } } : {})
+  };
+}
