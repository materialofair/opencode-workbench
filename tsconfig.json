{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src",
    "web",
    "tests",
    "scripts",
    "adapters"
  ]
}
