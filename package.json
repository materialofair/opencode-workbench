{
  "name": "opencode-workbench-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local scheduled tasks and optional Feishu integration for OpenCode",
  "license": "MIT",
  "exports": {
    ".": "./dist/plugin.js",
    "./feishu": "./adapters/feishu/plugin.js",
    "./browser": "./adapters/browser/plugin.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "demo": "bun scripts/demo.ts",
    "scan": "bun scripts/scan.ts",
    "scan:release": "bun scripts/release-audit.ts",
    "test:integration": "bun scripts/integration.ts",
    "prepare:feishu": "bun scripts/prepare-feishu.ts",
    "test:browser-chain": "bun scripts/browser-fixture-build.ts && node .data/browser-chain.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "@playwright/test": "1.56.1",
    "opencode-ai": "1.19.5"
  },
  "optionalDependencies": {
    "opencode-feishu": "1.10.10"
  },
  "overrides": {
    "@opencode-ai/plugin@1.19.5": {
      "zod": "4.6.7"
    },
    "effect@4.0.0-beta.83": {
      "toml": "5.0.1"
    }
  }
}
