{
  "name": "opencode-workbench-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local scheduled tasks and optional Feishu integration for OpenCode",
  "license": "MIT",
  "exports": {
    ".": "./src/plugin.ts",
    "./feishu": "./adapters/feishu/plugin.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
